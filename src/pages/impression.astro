---
import Base from '../layouts/Base.astro';
---
<Base title="Impression PDF" active="impression" page="impression">
  <h1 class="page-title grad">🖨️ Impression PDF</h1>
  <p class="page-lede">
    Générez un <b>PDF propre</b> d'un cas, d'une sélection de cas ou d'un <b>chapitre entier</b> :
    questions <b>et</b> corrigés, sans menus ni boutons — idéal pour réviser hors ligne ou imprimer.
  </p>

  <div class="app-panel" id="print-app">
    <p>Chargement du centre d'impression…</p>
  </div>
</Base>
